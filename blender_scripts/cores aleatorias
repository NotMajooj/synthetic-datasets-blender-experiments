import bpy
import random

# 1. Limpar a cena
bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.delete()

# 2. Criar objeto
bpy.ops.mesh.primitive_cube_add(size=1, location=(0, 0, 1))
target_object = bpy.context.active_object
target_object.name = "TargetObject"

# 3. EXPERIMENTO: cor aleatória a cada execução
mat = bpy.data.materials.new(name="CorAleatoria")
mat.use_nodes = True
principled = mat.node_tree.nodes.get("Principled BSDF")
cor_aleatoria = (random.random(), random.random(), random.random(), 1.0)
principled.inputs["Base Color"].default_value = cor_aleatoria
target_object.data.materials.append(mat)
print(f"Cor gerada: {cor_aleatoria}")

# 4. Luz
bpy.ops.object.light_add(type='SUN', location=(5, -5, 10))
light = bpy.context.active_object
light.data.energy = 5

# 5. Câmera
bpy.ops.object.camera_add(location=(5, -5, 5))
camera = bpy.context.active_object
bpy.context.scene.camera = camera

track = camera.constraints.new(type='TRACK_TO')
track.target = target_object
track.up_axis = 'UP_Y'
track.track_axis = 'TRACK_NEGATIVE_Z'

# 6. Configuração de render
bpy.context.scene.render.engine = 'CYCLES'
bpy.context.scene.cycles.samples = 64
bpy.context.scene.render.film_transparent = False
bpy.context.scene.render.image_settings.color_mode = 'RGB'
bpy.context.scene.view_settings.view_transform = 'Standard'
bpy.context.scene.render.filepath = "/home/maju/synthetic-datasets-blender-experiments/assets/render_cor_aleatoria_3.png"
bpy.ops.render.render(write_still=True)